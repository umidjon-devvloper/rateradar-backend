{
  "name": "rateradar-backend",
  "version": "0.1.0",
  "description": "RateRadar — Hotel narx monitoring (multi-provider rotator + Gemini AI)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --max-old-space-size=4096 src/server.js",
    "predev": "kill-port 5000",
    "dev": "nodemon src/server.js",
    "seed": "node src/utils/seed.js",
    "test": "node --test \"test/**/*.test.js\"",
    "migrate:rate-history": "node scripts/rate-history-migrate.js"
  },
  "nodemonConfig": {
    "nodeArgs": [
      "--max-old-space-size=4096"
    ]
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "morgan": "^1.10.0",
    "nanoid": "^3.3.12",
    "node-cron": "^4.2.1",
    "node-fetch": "^2.7.0",
    "nodemailer": "^8.0.7",
    "openai": "^6.37.0",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "telegraf": "^4.16.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "kill-port": "^2.0.1",
    "nodemon": "^3.1.7"
  },
  "engines": {
    "node": ">=18"
  }
}
