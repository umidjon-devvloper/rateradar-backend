# ════════════════════════════════════════════════════
# RATERADAR — ENVIRONMENT VARIABLES
# .env nomi bilan ko'chiring va o'zingizning kalitlarni qo'ying
# ════════════════════════════════════════════════════

# --- Asosiy ---
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/rateradar
JWT_SECRET=change-this-to-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@rateradar.com
ADMIN_PASSWORD=changeme123

# API hujjatlari (/api/docs) uchun Basic Auth login/parol.
# DOCS_PASSWORD bo'sh bo'lsa, ADMIN_PASSWORD ishlatiladi.
DOCS_USER=admin
DOCS_PASSWORD=

# --- CORS / Frontend manzillari ---
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ════════════════════════════════════════════════════
# AI — OpenAI GPT (gpt-4o-mini)
# https://platform.openai.com/api-keys
# ════════════════════════════════════════════════════
OPENAI_API_KEY=

# ════════════════════════════════════════════════════
# AI — Google Gemini (BEPUL: 1500/kun, gemini-2.5-flash)
# https://aistudio.google.com/apikey
# ════════════════════════════════════════════════════
GEMINI_API_KEY=

# ════════════════════════════════════════════════════
# SERP — SerpAPI  ← YAGONA NARX MANBASI
# engine=google_hotels orqali barcha OTA narxlari:
#   Booking.com, Agoda, Hotels.com, Trip.com, Expedia ...
# Bepul: 100 ta so'rov/oy
# https://serpapi.com/manage-api-key
# ════════════════════════════════════════════════════
SERPAPI_API_KEY=

# ════════════════════════════════════════════════════
# APIFY — Web scraping (Booking.com, Expedia, Agoda, Hotels.com, Trip.com)
# Bepul: $5/oy kredit (taxminan 500-1000 hotel scraping)
# https://console.apify.com/account/integrations
# ════════════════════════════════════════════════════
APIFY_API_KEY=

# ════════════════════════════════════════════════════
# JOY MA'LUMOTLARI
# ════════════════════════════════════════════════════

# Google Places API — $200 kredit /oy bepul (~6,000 so'rov)
# Hotel rasmlari va rating uchun (ixtiyoriy)
# https://console.cloud.google.com/google/maps-apis
GOOGLE_PLACES_API_KEY=

# GeoNames — to'liq bepul (foydalanuvchi nomi yetarli)
# http://www.geonames.org/login (ro'yxatdan keyin "Free Web Services"ni yoqing)
GEONAMES_USERNAME=demo
# Shahar qidiruvi manbasi: auto | api | local. VPS'da dump yuklamaslik uchun 'api'.
CITIES_SOURCE=api

# ════════════════════════════════════════════════════
# EMAIL ALERTS — Raqib narx o'zgarishi ogohlantirishlari
# Gmail uchun: App Password yarating (2FA yoqilgan bo'lishi kerak)
# https://myaccount.google.com/apppasswords
# ════════════════════════════════════════════════════
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=RateRadar <your@gmail.com>

# ════════════════════════════════════════════════════
# HOTEL SERVICE — Mehmonxona xodim-xizmati moduli (/hotel-service)
# Telegram bot orqali mehmon buyurtmalarini xodimlarga yetkazadi.
# BOT_TOKEN bosh bolsa, modul ishlaydi (bot ochiq qoladi).
# ════════════════════════════════════════════════════
BOT_TOKEN=
BOT_USERNAME=YOUR_BOT
SSO_SECRET=
MYMEMORY_EMAIL=

# ════════════════════════════════════════════════════
# ATMOS — to'lov shlyuzi (UzCard / Humo)
# Kalitlarni ATMOS merchant kabinetidan oling.
# Test kartalar (PAN: 9860090101014364, expiry: 02/28, OTP: 111111) shu
# kalitlar bilan sandbox rejimida ishlaydi.
#   • ATMOS_CONSUMER_KEY / SECRET — token olish uchun
#   • ATMOS_STORE_ID               — merchant (store) id
#   • ATMOS_TERMINAL_ID            — ixtiyoriy (1 terminal bo'lsa kerak emas)
#   • ATMOS_API_KEY                — Callback imzosini tekshirish uchun
# ════════════════════════════════════════════════════
ATMOS_BASE_URL=https://apigw.atmos.uz
ATMOS_CONSUMER_KEY=
ATMOS_CONSUMER_SECRET=
ATMOS_STORE_ID=
ATMOS_TERMINAL_ID=
ATMOS_API_KEY=

# ════════════════════════════════════════════════════
# Hotels scraper MIKROSERVISI (alohida puppeteer server)
# Boshqa barcha manba (Google Places, SERP, OSM) mehmonxonani topmasa, oxirgi
# chora sifatida shu serverga HTTP so'rov yuboriladi va u Booking.com'ni real
# vaqtda skreyp qilib aniq ma'lumot qaytaradi.
# Skreyper alohida ishlaydi:  cd hotels-scraper-js-main && npm run dev
#   • HOTEL_SCRAPER_ENABLED  — true (default) / false
#   • HOTEL_SCRAPER_URL      — skreyper server manzili (default http://localhost:3000)
#   • HOTEL_SCRAPER_API_KEY  — skreyper .env dagi API_KEYS kalitlaridan biri (masalan dev-key-123)
# ════════════════════════════════════════════════════
HOTEL_SCRAPER_ENABLED=true
HOTEL_SCRAPER_URL=http://localhost:3000
HOTEL_SCRAPER_API_KEY=dev-key-123

# "Narxlarni yangilash" (refresh-all) da raqiblar bir vaqtda nechtadan parallel
# qayta ishlanadi. Default 5. SerpAPI asosiy manba bo'lsa 8-10 ham bemalol.
# Faqat skreyper (SerpAPI'siz) ishlatilsa, skreyperning SCRAPE_CONCURRENCY'sidan
# oshirish foyda bermaydi (u yerda navbatga turadi).
REFRESH_COMPETITOR_CONCURRENCY=5

# ════════════════════════════════════════════════════
# EXELY (Connect API) — mehmonxonaning O'Z bron ma'lumoti
# Occupancy / ADR / RevPAR / booking pace shundan hisoblanadi.
#
# MUHIM: client_id va client_secret BU YERGA yozilmaydi. Ular har bir
# mijoz uchun alohida — Settings → Integratsiyalar orqali kiritiladi va
# bazada AES-256-GCM bilan shifrlangan holda saqlanadi (multi-tenant).
#
#   • EXELY_BASE_URL — prod: https://connect.hopenapi.com
#                      test: https://connect.test.hopenapi.com
#   • EXELY_ENC_KEY  — secret'larni shifrlash kaliti. Bo'sh bo'lsa
#       JWT_SECRET'dan hosil qilinadi. PRODUCTIONDA ALOHIDA QO'YING va
#       HECH QACHON O'ZGARTIRMANG (o'zgarsa saqlangan secretlar yaroqsiz).
#       Yaratish:  openssl rand -hex 32
#   • EXELY_SYNC_ENABLED — cron sinxronizatsiya (har 30 daqiqada)
# ════════════════════════════════════════════════════
EXELY_BASE_URL=https://connect.hopenapi.com
EXELY_ENC_KEY=
EXELY_SYNC_ENABLED=true
